Thumbs.db

# Scratch files. Agents/experiments working in this repo have repeatedly created
# ad-hoc `tmp_*.py` probes in the root; they are not deliverables. This is a safety
# net so a `git add -A` can never sweep them into a commit - they should still be
# deleted when the work they supported is done.
tmp_*.py
scratch_*.py

# DSH session metadata
.claude/

# Accidentally nested copy of C:\Users\...\mne_data created by an early
# MOABB/MNE path-sanitization bug (see the note in src/config.py). Local
# artifact only - the real cache lives in data/.
C-/
